# Environment
ENVIRONMENT=development
PROJECT_NAME="PlantTwin AI Backend v2.0"
API_V1_STR="/api/v1"

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=planttwin
POSTGRES_PASSWORD=planttwin_secret
POSTGRES_DB=planttwin_db

# Security & JWT
JWT_SECRET_KEY=planttwin_super_secret_jwt_key_32bytes_min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Caching & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379

# Siemens & Industrial Connectivity Defaults
SIEMENS_S7_IP=192.168.0.1
OPCUA_SERVER_URL=opc.tcp://localhost:4840
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
